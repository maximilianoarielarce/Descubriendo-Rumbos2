# Variables para Vercel (Environment Variables en el dashboard)
# En local: copiá a Backend/.env y Frontend/.env

# --- Backend / API ---
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=Ecommerce
MP_ACCESS_TOKEN=tu_access_token_mercadopago
FRONTEND_URL=https://tu-proyecto.vercel.app

# Cloudinary (https://cloudinary.com — cuenta gratis)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# --- Frontend (prefijo VITE_ obligatorio) ---
# Dejá vacío en Vercel si front y API comparten el mismo dominio
VITE_API_URL=
VITE_APP_MP_PUBLIC_KEY=tu_public_key_mercadopago
